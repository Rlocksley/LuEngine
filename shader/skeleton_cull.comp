#version 460
#extension GL_EXT_nonuniform_qualifier : enable

// Define the workgroup size
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ------------------------------------------------------------------
// Structs
// ------------------------------------------------------------------

struct Transform{
    mat4 model;
    mat4 normal;
    vec4 scale; // xyz = scale, w = padding
    vec4 rotation; // quaternion
    vec4 position;
};

struct MeshInfo {
    uint indexCount;
    uint firstIndex;
    uint vertexCount;
    int  vertexOffset;
    vec4 boundingSphere; // xyz = local center, w = radius
};

struct Material{
    uvec4 texturesIds; // x = albedo, y = normal, z = roughness, w = metallic
    vec4 albedo;
    vec4 ambient;
    vec4 emission;
    float roughness;
    float metallic;
    uint emissionTextureId;
    uint pad0;
};

struct Mesh {
    Material material;
    uint transformId;
    uint pipelineId;
    uint meshInfoId;
    uint skeletonId;
    uint nodeIndex;     // 0xFFFFFFFF = deformed, otherwise attached to this node
    uint valid;
    uint localTransformId;   // MeshTransform slot, 0 = identity
    uint pad1;
};

// Fits VkDrawIndexedIndirectCommand
struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};



// ------------------------------------------------------------------
// Bindings
// ------------------------------------------------------------------

layout(set = 0, binding = 0) uniform CameraBuffer {
    vec4 frustumPlanes[6];
    mat4 projection;       // Projection matrix
    mat4 view;             // View matrix (world → view)
    mat4 viewProjection;
    mat4 inverseProjection;// Inverse of projection
    vec4 camPos;
    vec4 camDir;
    vec2 screenSize;       // Width, height in pixels
    float nearClip;        // Near plane distance
    float farClip;         // Far plane distance
    float deltaTime;
    float time;
} camera;

layout(set = 0, binding = 1) readonly buffer TransformBuffer {
    Transform transforms[];
} transforms;

layout(set = 0, binding = 2) readonly buffer MeshInfoBuffer {
    MeshInfo meshInfos[];
} meshInfos;

layout(set = 0, binding = 3) readonly buffer MeshBuffer {
    Mesh meshes[];
} meshes;

layout(set = 0, binding = 4) buffer DrawCountBuffer {
    uint count[];
} drawCounts;

layout(set = 0, binding = 5) readonly buffer CapacityBuffer {
    uint capacity[];
} indirectCapacities;

layout(set = 0, binding = 6) writeonly buffer IndirectDrawCommandBuffer {
    DrawIndexedIndirectCommand commands[];
} indirectBuffers[];

layout(set = 0, binding = 7) writeonly buffer DepthIndirectDrawCommandBuffer {
    DrawIndexedIndirectCommand commands[];
} indirectBufferDepth;

layout(set = 0, binding = 8) buffer DepthDrawCountBuffer {
    uint count;
} depthDrawCount;

layout(set = 0, binding = 9) readonly buffer SkeletonBuffer {
    mat4 data[];
} skeletons;

#define MAX_BONES_PER_SKELETON 128u
#define MATS_PER_SKELETON (2u * MAX_BONES_PER_SKELETON)
// Deformed meshes change shape: the bind pose sphere is inflated.
const float SKELETON_CULL_PADDING = 1.5;

// ------------------------------------------------------------------
// Helper Functions
// ------------------------------------------------------------------

bool isVisible(vec4 sphere) {
    // Simple sphere-frustum check
    for (int i = 0; i < 6; i++) {
        if (dot(camera.frustumPlanes[i], vec4(sphere.xyz, 1.0)) < -sphere.w) {
            return false;
        }
    }
    return true;
}

bool tryReserveCommandSlot(uint shaderIndex, out uint cmdIndex) {
    cmdIndex = atomicAdd(drawCounts.count[shaderIndex], 1);
    uint maxCommands = indirectCapacities.capacity[shaderIndex];
    return cmdIndex < maxCommands;  
}

// ------------------------------------------------------------------
// Main
// ------------------------------------------------------------------

void main() {
    uint gID = gl_GlobalInvocationID.x;

    // Boundary check
    if (gID >= meshes.meshes.length()) {
        return;
    }

    // 1. Fetch Object Data
    Mesh mesh = meshes.meshes[gID];

    // Check if this slot is empty/invalid
    if (mesh.valid==0) {
        return;
    }
    
    //fetch pointers
    MeshInfo meshInfo = meshInfos.meshInfos[mesh.meshInfoId];
    Transform transform = transforms.transforms[mesh.transformId];
    Transform local = transforms.transforms[mesh.localTransformId];   // MeshTransform (slot 0 = identity)

    //Transform Bounding Sphere to World Space
    vec3 localCenter = meshInfo.boundingSphere.xyz;
    float radiusScale = SKELETON_CULL_PADDING;
    if (mesh.nodeIndex != 0xFFFFFFFFu) {
        // rigidly attached: follow the node
        mat4 nodeMatrix = skeletons.data[mesh.skeletonId * MATS_PER_SKELETON + MAX_BONES_PER_SKELETON + mesh.nodeIndex];
        localCenter = (nodeMatrix * vec4(localCenter, 1.0)).xyz;
        radiusScale = 1.0;
    }
    vec3 worldCenter = (transform.model * local.model * vec4(localCenter, 1.0)).xyz;
    vec4 scale = transform.scale;
    vec4 localScale = local.scale;
    float worldRadius = meshInfo.boundingSphere.w * radiusScale
        * max(max(abs(scale.x), abs(scale.y)), abs(scale.z))
        * max(max(abs(localScale.x), abs(localScale.y)), abs(localScale.z));

    //Frustum Cull with World Sphere
    if (isVisible(vec4(worldCenter, worldRadius))) {

        // Every visible mesh contributes to the depth prepass, regardless of pipeline.
        DrawIndexedIndirectCommand cmd;
        cmd.indexCount    = meshInfo.indexCount;
        cmd.instanceCount = 1;             
        cmd.firstIndex    = meshInfo.firstIndex;
        cmd.vertexOffset  = meshInfo.vertexOffset;
        cmd.firstInstance = gID;           // Pass global ID to Vertex Shader (gl_InstanceIndex)

        uint depthCmdIndex = atomicAdd(depthDrawCount.count, 1);
        if (depthCmdIndex < indirectBufferDepth.commands.length()) {
            indirectBufferDepth.commands[depthCmdIndex] = cmd;
        }

        uint shaderIndex = mesh.pipelineId; 
        uint cmdIndex = 0;
        if (!tryReserveCommandSlot(shaderIndex, cmdIndex)) {
            return;
        }

        // 9. Write to the specific Indirect Buffer
        // We use the nonuniform index here to select the correct buffer from the array.
        indirectBuffers[nonuniformEXT(shaderIndex)].commands[cmdIndex] = cmd;
    }
}
