#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct Transform {
    mat4 model;
    mat4 normal;
    vec4 scale;
    vec4 rotation;
    vec4 position;
};

struct Material {
    ivec4 texturesIds;
    vec4 albedo;
    vec4 ambient;
    vec4 emission;
    float roughness;
    float metallic;
    vec2 _pad;
};

struct MultiMeshTransform {
    Material material;
    Transform transform;
};

struct MultiMesh {
    uint transformId;
    uint computePipeId;
    uint pipelineId;
    uint meshInfoId;
    uint size;
    uint valid;
    uint _pad0;
    uint _pad1;
    uint64_t transformBufferAddress;
    uint _pad2;
    uint _pad3;
    vec4 cullSphere;
};

layout(buffer_reference, std430, buffer_reference_align = 16) buffer MultiMeshTransformBuffer {
    MultiMeshTransform values[];
};

layout(set = 0, binding = 0, std430) readonly buffer MultiMeshBuffer {
    MultiMesh values[];
} multiMeshes;

layout(push_constant) uniform MultiMeshDispatchData {
    uint multiMeshId;
    uint transformBufferLength;
    float deltaTime;
} pc;

const float attractorB = 0.208186;
const float attractorSpeedMultiplier = 0.5;

vec3 thomasDerivative(vec3 point) {
    return vec3(
        sin(point.y) - attractorB * point.x,
        sin(point.z) - attractorB * point.y,
        sin(point.x) - attractorB * point.z
    );
}

vec3 integrateThomas(vec3 point) {
    float dt = pc.deltaTime * attractorSpeedMultiplier;
    vec3 k1 = thomasDerivative(point);
    vec3 k2 = thomasDerivative(point + 0.5 * dt * k1);
    vec3 k3 = thomasDerivative(point + 0.5 * dt * k2);
    vec3 k4 = thomasDerivative(point + dt * k3);
    return point + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4);
}

vec3 hsvToRgb(vec3 hsv) {
    vec3 p = abs(fract(hsv.xxx + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return hsv.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), hsv.y);
}

void main() {
    uint instanceId = gl_GlobalInvocationID.x;
    if (instanceId >= pc.transformBufferLength) {
        return;
    }

    MultiMesh mesh = multiMeshes.values[pc.multiMeshId];
    if (mesh.valid == 0u) {
        return;
    }

    MultiMeshTransformBuffer transforms = MultiMeshTransformBuffer(mesh.transformBufferAddress);
    MultiMeshTransform instance = transforms.values[instanceId];
    Transform transform = instance.transform;
    transform.position.xyz = integrateThomas(transform.position.xyz);
    transform.model[3] = vec4(transform.position.xyz, 1.0);

    // Map the attractor's evolving 3D state to a vivid, smoothly varying palette.
    vec3 point = transform.position.xyz;
    float angleHue = atan(point.y, point.x) * 0.15915494;
    float hue = fract(0.56 + angleHue + point.z * 0.035);
    float activity = clamp(length(thomasDerivative(point)) * 0.35, 0.0, 1.0);
    vec3 color = hsvToRgb(vec3(hue, 0.9, 0.78 + 0.22 * activity));

    instance.transform = transform;
    instance.material.albedo = vec4(color, 1.0);
    instance.material.ambient = vec4(color * 0.10, 1.0);
    instance.material.emission = vec4(color * (0.08 + 0.16 * activity), 1.0);
    instance.material.roughness = 0.32 + 0.28 * (1.0 - activity);
    instance.material.metallic = 0.12 + 0.28 * activity;
    transforms.values[instanceId] = instance;
}