#version 450
struct Clip2D { vec2 position; vec2 size; };
struct Clip2DInstance { Clip2D clip; uint id; uint pad0; uint pad1; uint pad2; };
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Clip2DInstanceArray { Clip2DInstance instances[]; } clip2DInstanceArray;
layout(std430,binding=1) writeonly buffer Clip2DArray { Clip2D clips[]; } clip2Darray;
layout(push_constant) uniform Push { uint count; } pc;
void main(){ uint i=gl_GlobalInvocationID.x; if(i<pc.count) clip2Darray.clips[clip2DInstanceArray.instances[i].id]=clip2DInstanceArray.instances[i].clip; }

