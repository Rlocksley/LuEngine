{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build lu_example4 (Debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug",
        "--target",
        "lu_example4"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Build lu_example4 (Release with debug info)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "RelWithDebInfo",
        "--target",
        "lu_example4"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
